rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /site/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /press/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /audio/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /video/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /private/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
