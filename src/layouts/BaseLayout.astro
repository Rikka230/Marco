---
// Coquille persistante du site Marco (ex-`.shell` de index.html).
// Contient mini-brand, <main id="app"> (slot = contenu de page), dotWave et mini-player.
// Phase A : CSS historiques importes verbatim pour garantir la parite visuelle.
// Le decoupage tokens.css/global.css interviendra en Phase B/C.
import '../../style.css';
import '../../assets/css/model-page.css';
import '../../assets/css/marco-bg-veil.css';

interface Props {
  title: string;
  description?: string;
  /** Valeur data-marco-page : pilote le theme/accent global (rendu cote serveur = zero latence). */
  page: string;
}

const {
  title,
  description = 'Prototype cover interactive pour Marco Charlas-Hou, violoniste, compositeur, acteur et modele.',
  page,
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body data-marco-page={page}>
    <div class="film-grain" aria-hidden="true"></div>
    <div class="shell">
      <a class="mini-brand" href="/" aria-label="Retour accueil"><span></span>MARCO CHARLAS-HOU</a>

      <main id="app">
        <slot />
      </main>

      <canvas id="dotWave" aria-hidden="true"></canvas>
      <div class="mini-player">
        <button id="playBtn" type="button" aria-label="Lancer la boucle audio">PLAY</button>
        <span class="track-label"><b>92 BPM</b><b>LIVE STRINGS</b><b>VIOLIN - SCORE - IMAGE</b></span>
        <audio id="audioLoop" src="/assets/audio/soft-loop.wav" preload="auto" loop></audio>
      </div>
    </div>
  </body>
</html>
