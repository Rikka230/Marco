---
// Coquille persistante du site Marco (ex-`.shell` de index.html).
// - <ClientRouter /> : View Transitions natives (remplacent le routeur PJAX maison).
// - mini-player / dotWave / rail : transition:persist => audio continu + pas de re-init.
// - data-marco-page rendu cote serveur => accent/theme sans latence (CSS pur).
import { ClientRouter } from 'astro:transitions';
import ChapterNav from '../components/ChapterNav.astro';
import '../../style.css';
import '../../assets/css/model-page.css';
import '../../assets/css/marco-bg-veil.css';
import '../styles/transitions.css';

interface Props {
  title: string;
  description?: string;
  /** Cle marco-page : pilote l'accent global + le rail (home|music|parcours|gallery|filmographie|composition|booking). */
  page: string;
  /** Feuilles CSS specifiques a la page, servies depuis /assets (link reel, compatible ClientRouter). */
  pageStyles?: string[];
}

const {
  title,
  description = 'Prototype cover interactive pour Marco Charlas-Hou, violoniste, compositeur, acteur et modele.',
  page,
  pageStyles = [],
} = Astro.props;

// Badge de build TEMPORAIRE (migration) — bumpe a chaque iteration, retire en Phase E.
const BUILD = 'MARCO 6.7';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {pageStyles.map((href) => <link rel="stylesheet" href={href} />)}
    <ClientRouter />
    <style is:global>
      /* Accent global par page (ex --marco-nav-accent pose par JS dans le PJAX, desormais CSS pur). */
      body[data-marco-page='home'] { --marco-nav-accent: #86f5a8; }
      body[data-marco-page='music'] { --marco-nav-accent: #f4bd68; }
      body[data-marco-page='parcours'] { --marco-nav-accent: #73aaf6; }
      body[data-marco-page='gallery'] { --marco-nav-accent: #f08ac8; }
      body[data-marco-page='filmographie'] { --marco-nav-accent: #f4bd68; }
      body[data-marco-page='composition'] { --marco-nav-accent: #ff355d; }
      body[data-marco-page='booking'] { --marco-nav-accent: #d8c3ff; }

      /* Canvas du visualizer WebGL : superpose a l'identique #dotWave (dans le stage). */
      #dotwave-gl {
        position: absolute; left: 0; right: 0; bottom: 0; z-index: 23;
        width: 100%; height: calc(88 * var(--u)); pointer-events: none;
        opacity: 0.78; mix-blend-mode: screen; display: none;
      }
      /* Quand le visualizer WebGL tourne : on l'affiche et on masque le dotWave 2D. */
      html[data-gl-viz='on'] #dotwave-gl { display: block; }
      html[data-gl-viz='on'] #dotWave { display: none; }

      /* Overlay shader de transition : remplit le stage, au-dessus de la page, sous la bande. */
      #transition-gl {
        position: absolute; inset: 0; width: 100%; height: 100%;
        z-index: 66; pointer-events: none; mix-blend-mode: screen;
      }

    </style>
    <script is:inline>
      /* Echelle du stage = min(largeur/2560, hauteur/1440).
         IMPORTANT : ClientRouter recopie les attributs du <html> entrant a chaque
         navigation et EFFACE le style inline --k -> il faut le reappliquer apres
         chaque swap (sinon la page entrante s'affiche a l'echelle 1 = "gros zoom"). */
      (function () {
        function setK() {
          var k = Math.min(window.innerWidth / 2560, window.innerHeight / 1440);
          document.documentElement.style.setProperty('--k', String(k));
        }
        setK();
        window.addEventListener('resize', setK, { passive: true });
        document.addEventListener('astro:before-swap', setK);
        document.addEventListener('astro:after-swap', setK);
        document.addEventListener('astro:page-load', setK);
      })();
    </script>
  </head>
  <body data-marco-page={page} style={`--marco-build: '${BUILD}'`}>
    <div class="film-grain" aria-hidden="true"></div>
    <div class="shell">
      <!-- STAGE : toute la page a taille de reference 2560x1440, mise a l'echelle
           d'un bloc (transform: scale(--k)) pour tenir dans l'ecran. Le fond noir
           de .shell forme les barres letterbox sur les formats != 16:9. -->
      <div class="stage">
        <main id="app">
          <slot />
        </main>

        <canvas id="dotWave" aria-hidden="true" transition:persist="dotwave"></canvas>
        <canvas id="dotwave-gl" aria-hidden="true" transition:persist="dotwave-gl"></canvas>

        <!-- Chrome persistante (brand + mini-player + rail). Un seul persist sur le
             wrapper => audio continu + rail conserve (pas de double-persist). -->
        <div class="compo-chrome" transition:persist="compo-chrome">
          <a class="mini-brand" href="/" aria-label="Retour accueil"><span></span>MARCO CHARLAS-HOU</a>

          <div class="mini-player">
            <button id="playBtn" type="button" aria-label="Lancer la boucle audio">PLAY</button>
            <span class="track-label"><b>92 BPM</b><b>LIVE STRINGS</b><b>VIOLIN - SCORE - IMAGE</b></span>
            <audio id="audioLoop" src="/assets/audio/soft-loop.wav" preload="auto" loop></audio>
          </div>

          <ChapterNav active={page} />
        </div>

        <canvas id="transition-gl" aria-hidden="true" transition:persist="transition-gl"></canvas>
        <div class="transition-band" aria-hidden="true" transition:persist="transition-band"><span></span></div>
      </div>
    </div>

    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
