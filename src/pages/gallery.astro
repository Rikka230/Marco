---
// Page Modele — strips photo + lightbox.
// Donnees lues depuis Firestore au build (fallback = contenu historique).
// La logique autoscroll/lightbox (model-page.js) lit le DOM => rien a changer cote JS.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getGalleryContent } from '../lib/content';

const { strips } = await getGalleryContent();
---

<style is:global>
  /* Couche de profondeur WebGL de la page Modele : ambiante, derriere les strips. */
  #gallery-gl {
    position: fixed; inset: 0; width: 100vw; height: 100vh;
    z-index: 8; pointer-events: none; opacity: 0.9;
  }
</style>


<BaseLayout title="Marco Charlas-Hou - Modèle" description="Portfolio modèle, portraits, campagnes, éditorial et visuels de casting de Marco Charlas-Hou." page="gallery" preloadImages={['/assets/img/bg-gallery.webp']}>
  <section class="page poster-page inner gallery model-page" data-page="gallery" data-bg="gallery" data-theme="gallery" data-transition-label="MODELE" aria-labelledby="model-title">
    <div class="photo-bg" aria-hidden="true"></div>
    <div class="model-atmosphere" aria-hidden="true"></div>
    <canvas id="gallery-gl" aria-hidden="true"></canvas>

    <div class="model-strip-field" aria-label="Bandes photo du portfolio modèle">
      {strips.map((strip) => (
        <section class:list={['model-strip', `model-strip-${strip.key}`]} aria-labelledby={strip.headingId}>
          <div class="model-strip-heading">
            <span>{strip.num}</span>
            <strong id={strip.headingId}>{strip.heading}</strong>
            <em>{strip.sub}</em>
          </div>
          <div class="model-strip-track" data-speed={strip.speed} tabindex="0" aria-label={`Défiler : ${strip.heading}`}>
            <div class="model-strip-row">
              {strip.frames.map((f) => (
                <button
                  class:list={['model-frame', { 'is-featured': f.featured, 'is-wide': f.wide }]}
                  type="button" data-photo-id={f.id} data-src={f.src} data-title={f.title} data-meta={f.meta}
                >
                  <img loading="lazy" decoding="async" src={f.src} alt={f.title} /><span>{f.label}</span>
                </button>
              ))}
            </div>
          </div>
          <div class="model-strip-progress" aria-hidden="true"><span></span></div>
        </section>
      ))}
    </div>

    <div class="title-wrap model-title-wrap" aria-hidden="true">
      <h1 id="model-title" class="mega first">MODELE</h1>
      <h2 class="mega last">PHOTO BOOK</h2>
    </div>

    <div class="model-copy model-copy-left" aria-label="Positionnement modèle">
      <strong>ACTING MODEL</strong>
      <span>Editorial / campaign / commercial image</span>
    </div>

    <div class="model-copy model-copy-right" aria-label="Catégories photographie">
      <strong>PORTRAITS</strong>
      <strong>CAMPAIGNS</strong>
      <strong>CASTING VISUALS</strong>
    </div>

    <div class="model-copy model-copy-bottom" aria-label="Instructions interaction">
      <span>Hover a strip + wheel to browse</span>
      <span>Click any frame to open lightbox</span>
    </div>

    <img decoding="async" class="hero-person page-person gallery-person model-person" src="/assets/img/marco-gallery.webp" alt="Portrait détouré de Marco pour la page modèle" />

    <div class="model-booking-note" aria-hidden="true">
      <span>MODEL BOOK</span>
      <b>Editorial</b>
      <b>Campaign</b>
      <b>Press visuals</b>
    </div>
  </section>
</BaseLayout>
