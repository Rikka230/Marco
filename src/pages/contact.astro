---
// Page Booking / Contact — refonte selon mockup (booking_mockup.png).
// Figure centrale = marco-booking.webp (detouree). Formulaire front-only conserve.
import BaseLayout from '../layouts/BaseLayout.astro';

const offers = [
  { k: 'LIVE PERFORMANCE', meta: 'SOLO / ENSEMBLE', stat: 'SUR DEVIS' },
  { k: 'FILM SCORE', meta: 'COMPOSITION / SESSION', stat: 'PROJET' },
  { k: 'BRAND / IMAGE', meta: 'ACTING / MODEL', stat: 'CASTING' },
];

const requestTypes = ['Booking', 'Collaboration', 'Score / Composition', 'Image / Model', 'Acteur'];
---

<BaseLayout title="Marco Charlas-Hou - Booking" description="Booking, collaborations, press kit et contact professionnel de Marco Charlas-Hou : violon, score, image, acting." page="booking" pageStyles={['/assets/css/booking-page.css']} preloadImages={['/assets/img/marco-booking.webp']}>
  <section class="page booking-page booking-rebuild" data-page="booking" data-theme="contact" data-transition-label="BOOKING" aria-labelledby="booking-title">
    <div class="booking-bg" aria-hidden="true"></div>

    <h1 class="booking-mega" id="booking-title" aria-label="Booking">BOOKING</h1>

    <div class="booking-person-wrap" aria-hidden="true">
      <img decoding="async" class="booking-person" src="/assets/img/marco-booking.webp" alt="Portrait detoure de Marco Charlas-Hou en costume" />
    </div>

    <!-- Colonne gauche : pitch + offres -->
    <div class="booking-intro" aria-label="Booking et collaborations">
      <p class="booking-kicker">BOOKING</p>
      <h2>Collaborations</h2>
      <ul class="booking-roles">
        <li>Violinist</li>
        <li>Composer</li>
        <li>Actor</li>
        <li>Model</li>
      </ul>
      <p class="booking-lede">
        Pour toute demande professionnelle — performance live, composition de score, image
        de marque ou casting — un seul point de contact. Reponse rapide et adaptee a chaque projet.
      </p>
    </div>

    <ul class="booking-offers" aria-label="Types de prestations">
      {offers.map((o) => (
        <li class="booking-offer">
          <strong>{o.k}</strong>
          <span>{o.meta}</span>
          <em>{o.stat}</em>
        </li>
      ))}
    </ul>

    <!-- Colonne droite : formulaire -->
    <div class="booking-panel">
      <p class="booking-panel-kicker">VIOLIN / SCORE / IMAGE / CONTACT PRO</p>

      <form class="booking-form" data-contact-form>
        <div class="booking-row">
          <div class="contact-field">
            <label for="contact-name">Nom</label>
            <input id="contact-name" name="name" type="text" autocomplete="name" placeholder="Votre nom" required />
          </div>
          <div class="contact-field">
            <label for="contact-email">Email</label>
            <input id="contact-email" name="email" type="email" autocomplete="email" placeholder="vous@email.com" required />
          </div>
        </div>

        <fieldset class="request-type">
          <legend>Type de demande</legend>
          <div class="request-chips">
            {requestTypes.map((t, i) => (
              <label class="request-chip">
                <input type="radio" name="request_type" value={t} checked={i === 0} />
                <span>{t}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="contact-field contact-field-wide">
          <label for="contact-subject">Sujet</label>
          <input id="contact-subject" name="subject" type="text" placeholder="Objet de la demande" required />
        </div>

        <div class="contact-field contact-field-wide">
          <label for="contact-message">Message</label>
          <textarea id="contact-message" name="message" rows="3" placeholder="Decrivez votre projet..." required></textarea>
        </div>

        <button class="contact-submit" type="submit">SEND REQUEST</button>
        <p class="contact-status" data-form-status aria-live="polite"></p>
      </form>
    </div>
  </section>
</BaseLayout>
