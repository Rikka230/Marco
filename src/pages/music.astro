---
// Page Violon — portage fidele de music.html.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Marco Charlas-Hou - Violin" description="Violon, performances live, enregistrements et sessions de Marco Charlas-Hou." page="music">
  <section class="page poster-page inner music" data-page="music" data-bg="music" data-theme="music" data-transition-label="VIOLIN">
    <div class="photo-bg" aria-hidden="true"></div>
    <div class="string-lines" aria-hidden="true"></div>

    <div class="title-wrap" aria-hidden="true">
      <h1 class="mega first">VIOLIN</h1>
      <h2 class="mega last">LIVE STRINGS</h2>
    </div>

    <img class="hero-person page-person music-person" src="/assets/img/marco-music.png" alt="Portrait detoure placeholder de Marco avec violon" />

    <a class="cover-hit nav-home" href="/">
      <strong>HOME</strong>
      <span>COVER <i></i> IDENTITY</span>
    </a>
    <a class="cover-hit nav-projects" href="/projects">
      <strong>SCORES</strong>
      <span>FILM <i></i> STAGE</span>
    </a>
    <a class="cover-hit nav-gallery" href="/gallery">
      <strong>MODELE</strong>
      <span>PHOTO <i></i> CASTING</span>
    </a>
    <a class="cover-hit nav-contact" href="/contact">
      <strong>CONTACT</strong>
      <span>BOOKING <i></i> COLLABS</span>
    </a>

    <a class="key-project" href="/music" aria-label="Page musique">
      <span>LIVE SESSIONS</span>
      <span>RECORDINGS</span>
    </a>

    <div class="cover-tagline" aria-hidden="true">
      <span>BOWED TEXTURES</span>
      <span>STRING LANGUAGE</span>
    </div>

    <div class="editorial-stack music-stack" aria-hidden="true">
      <span>ORIGINALS</span>
      <span>SESSIONS</span>
      <span>SOLO / ENSEMBLE</span>
    </div>
  </section>
</BaseLayout>
