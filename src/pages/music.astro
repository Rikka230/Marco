---
// Page Violon — refonte premium selon mockup (Violin_mockup.png).
// Header dedie + grandes cartes Live Sessions + Featured + bandeau 3 colonnes + player plein largeur.
// Figure = marco-music.webp (Marco jouant, NE PAS modifier). Audio = mini-player global (cable plus bas).
import BaseLayout from '../layouts/BaseLayout.astro';
import { getMusicContent } from '../lib/content';

// Sessions / moods / dispos lues depuis Firestore au build (fallback = historique).
const { sessions, moods, dates } = await getMusicContent();

const services = [
  { t: 'CONCERT', svg: '<path d="M9 17V4l10-2v13"/><circle cx="6" cy="17" r="2.6"/><circle cx="16" cy="15" r="2.6"/>' },
  { t: 'STUDIO', svg: '<rect x="9" y="2.5" width="6" height="11" rx="3"/><path d="M5.5 11a6.5 6.5 0 0 0 13 0"/><line x1="12" y1="17.5" x2="12" y2="21"/><line x1="8.5" y1="21" x2="15.5" y2="21"/>' },
  { t: 'FILM SCORE', svg: '<rect x="3" y="7" width="18" height="13" rx="1.5"/><path d="M3 11.5h18"/><path d="M3.5 7l2.4-4h12.2l2.4 4"/><path d="M7.5 7l-1.4 4.5M12 7l-1.4 4.5M16.5 7l-1.4 4.5"/>' },
  { t: 'COLLABORATION', svg: '<circle cx="8" cy="8" r="3"/><circle cx="16" cy="8" r="3"/><path d="M2.5 20c0-3 2.5-5 5.5-5s5.5 2 5.5 5"/><path d="M13.2 20c0-3 2.4-5 5.3-5"/>' },
];

// Barres de waveform (deterministes, sinus + variation par index).
const wave = (n) => Array.from({ length: n }, (_, i) => 22 + Math.round(Math.abs(Math.sin(i * 0.6) + Math.sin(i * 0.27) * 0.5) * 56));
const sessionWave = wave(22);
const featuredWave = wave(34);
---

<BaseLayout title="Marco Charlas-Hou - Violin" description="Violon, performances live, enregistrements et sessions de Marco Charlas-Hou : strings cinematiques, solo et score." page="music" pageStyles={['/assets/css/music-page.css']} preloadImages={['/assets/img/marco-music.webp']}>
  <section class="page violin-page violin-rebuild" data-page="music" data-theme="music" data-transition-label="VIOLIN" aria-labelledby="violin-title">
    <div class="violin-bg" aria-hidden="true"></div>

    <!-- CTA (le logo MARCO CHARLAS-HOU = mini-brand persistant ; nav = rail global) -->
    <a class="violin-cta" href="/contact">BOOK A SESSION <i aria-hidden="true">&rarr;</i></a>

    <h1 class="violin-mega" id="violin-title" aria-label="Violin">VIOLIN</h1>

    <div class="violin-person-wrap" aria-hidden="true">
      <img decoding="async" class="violin-person" src="/assets/img/marco-music.webp" alt="Marco Charlas-Hou jouant du violon" />
    </div>

    <!-- LIVE SESSIONS (gauche) -->
    <section class="violin-sessions" aria-labelledby="violin-sessions-title">
      <header>
        <h2 id="violin-sessions-title">LIVE SESSIONS</h2>
        <span>Strings &middot; score &middot; image</span>
      </header>
      <ul>
        {sessions.map((s) => (
          <li class:list={['violin-session', { 'is-active': s.active }]}>
            <span class="violin-session-num">{s.n}</span>
            <span class="violin-session-thumb" style={`background-image:url('${s.img}')`} aria-hidden="true"></span>
            <div class="violin-session-info">
              <strong>{s.t}</strong>
              <span class="sub">{s.sub}</span>
              <span class="cat">{s.cat}</span>
            </div>
            <div class="violin-session-wave" aria-hidden="true">
              {sessionWave.map((h) => <i style={`height:${h}%`}></i>)}
            </div>
            <em class="violin-session-dur">{s.d}</em>
            <button type="button" class="violin-play" aria-label={`Ecouter ${s.t}`}><span></span></button>
          </li>
        ))}
      </ul>
    </section>

    <!-- FEATURED (droite) -->
    <aside class="violin-featured" aria-labelledby="violin-featured-title">
      <p class="violin-kicker" id="violin-featured-title">FEATURED PERFORMANCE</p>
      <div class="violin-featured-card">
        <div class="violin-featured-thumb" style="background-image:url('/assets/img/bg-music.webp')">
          <button type="button" class="violin-featured-play" aria-label="Lire Nocturne Session"><span></span></button>
        </div>
        <strong>NOCTURNE SESSION</strong>
        <span class="violin-featured-info">LIVE &middot; SOLO VIOLIN &middot; RECORDING</span>
        <em class="violin-featured-dur">04:12</em>
        <p class="violin-featured-desc">Une session nocturne au violon solo, captee en prise live — texture intime et cinematique.</p>
        <div class="violin-featured-wave" aria-hidden="true">
          {featuredWave.map((h) => <i style={`height:${h}%`}></i>)}
        </div>
      </div>
    </aside>

    <!-- BANDEAU BAS (3 colonnes) -->
    <div class="violin-band">
      <section class="violin-band-col violin-moods" aria-label="Repertoire et ambiances">
        <p class="violin-kicker">REPERTOIRE / MOODS</p>
        <div class="violin-tags">
          {moods.map((m) => <span class="violin-tag">{m}</span>)}
        </div>
      </section>

      <section class="violin-band-col violin-availability" aria-label="Disponibilites">
        <p class="violin-kicker">UPCOMING / AVAILABILITY</p>
        <ul>
          {dates.map((d) => (
            <li>
              <b>{d.day}</b>
              <span>{d.t}</span>
              <em>{d.loc}</em>
              <a class="violin-book-mini" href="/contact">BOOK</a>
            </li>
          ))}
        </ul>
      </section>

      <section class="violin-band-col violin-services" aria-label="Reservation">
        <p class="violin-kicker">BOOK A SESSION</p>
        <div class="violin-service-grid">
          {services.map((s) => (
            <a class="violin-service" href="/contact">
              <svg class="violin-service-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={s.svg}></svg>
              <b>{s.t}</b>
            </a>
          ))}
        </div>
      </section>
    </div>

  </section>

  <script>
    // Cable les boutons play des cartes violon sur le mini-player audio global (#playBtn).
    if (!(window as any).__violinAudioWired) {
      (window as any).__violinAudioWired = true;
      document.addEventListener('click', (e) => {
        const t = (e.target as Element)?.closest?.('.violin-play, .violin-featured-play');
        if (t) (document.getElementById('playBtn') as HTMLButtonElement | null)?.click();
      });
    }
  </script>
</BaseLayout>
