---
// Page Composition (v0.4.6) — portage de composition.html, CSS inline externalise.
// Les clics .track-play sont geres par l'AudioManager (src/scripts/audio.ts).
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompositionContent } from '../lib/content';

// Donnees lues depuis Firestore au build (fallback = contenu historique).
const { tracks } = await getCompositionContent();
---

<BaseLayout title="Marco Charlas-Hou - Composition" description="Catalogue des musiques composées par Marco Charlas-Hou : scores, démos, morceaux originaux et projets liés." page="composition" pageStyles={['/assets/css/composition-page.css']} preloadImages={['/assets/img/bg-scores.webp']}>
  <section class="page poster-page inner composition-page" data-page="composition" data-bg="scores" data-theme="composition" data-transition-label="COMPOSITION">
    <div class="photo-bg" aria-hidden="true"></div>
    <div class="film-sweep" aria-hidden="true"></div>

    <div class="title-wrap" aria-hidden="true">
      <h1 class="mega first">COMPOSITION</h1>
      <h2 class="mega last">ORIGINAL MUSIC</h2>
    </div>

    <img decoding="async" class="hero-person page-person composition-person music-person" src="/assets/img/marco-comp.webp" alt="Portrait detoure de Marco pour la page Composition" />
    <span class="marco-person-shader" aria-hidden="true"></span>

    <a class="key-project" href="/composition" aria-label="Catalogue des compositions"><span>TRACKS CATALOG</span><span>COMPOSED WORKS</span></a>

    <div class="composition-intro" aria-label="Introduction compositions">
      <strong>CATALOGUE / SCORE / DEMO</strong>
      <span>Une page dediee aux musiques composees : morceaux originaux, themes, demos, scores et projets lies.</span>
    </div>

    <div class="composition-diagonal-zone" aria-label="Liste des musiques composees">
      <div class="composition-track-scroll">
        {tracks.map((track) => (
          <article class:list={['composition-track', { 'is-active': track.active }]} data-track-title={track.title}>
            <span class="track-index">{track.n}</span>
            <div class="track-main">
              <strong class="track-title">{track.title}</strong>
              <span class="track-meta">{track.meta.map((m) => <b>{m}</b>)}</span>
            </div>
            <button class="track-play" type="button">Play</button>
          </article>
        ))}
      </div>
    </div>

    <div class="composition-side-note" aria-hidden="true"><span>Scroll</span><br /><span>Diagonal</span><br /><span>Track list</span></div>
  </section>
</BaseLayout>
