---
// Page Parcours — portage fidele de parcours.html (desktop + flux mobile).
// Contenu rendu par assets/js/parcours-page.js (via le shim de cycle de vie).
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Marco Charlas-Hou - Parcours" description="Parcours, études, expériences professionnelles et compétences artistiques de Marco Charlas-Hou." page="parcours" pageStyles={['/assets/css/parcours-page.css']}>
  <section class="page poster-page inner parcours-page parcours-rebuild" data-page="parcours" data-bg="scores" data-theme="parcours" data-transition-label="PARCOURS" aria-labelledby="parcours-title">
    <div class="photo-bg" aria-hidden="true"></div>
    <div class="parcours-atmosphere" aria-hidden="true"></div>

    <div class="title-wrap parcours-title-wrap" aria-hidden="true">
      <h1 id="parcours-title" class="mega first">PARCOURS</h1>
      <h2 class="mega last">TRAJECTOIRE</h2>
    </div>

    <img class="hero-person page-person parcours-person" src="/assets/img/marco-parcour.webp" alt="Portrait detoure de Marco pour la page Parcours" />

    <div class="parcours-copy" aria-label="Positionnement du parcours">
      <span>Mon<br />parcours.</span>
      <p>De la formation &agrave; l'exp&eacute;rience, un chemin guid&eacute; par la passion et la <b>cr&eacute;ation</b>.</p>
    </div>

    <section class="parcours-zone parcours-studies" aria-labelledby="parcours-studies-title">
      <header>
        <span>01</span>
        <h2 id="parcours-studies-title">Formation / Études</h2>
      </header>
      <div class="parcours-study-list" data-parcours-studies></div>
    </section>

    <section class="parcours-timeline-zone" aria-labelledby="parcours-timeline-title" data-no-page-wheel>
      <header>
        <span>timeline dynamique</span>
        <h2 id="parcours-timeline-title">De la formation à l’expérience</h2>
      </header>
      <div class="parcours-timeline" data-parcours-timeline></div>
    </section>

    <section class="parcours-zone parcours-experiences" aria-labelledby="parcours-experiences-title">
      <header>
        <span>02</span>
        <h2 id="parcours-experiences-title">Expériences</h2>
      </header>
      <div class="parcours-experience-list" data-parcours-experiences></div>
    </section>

    <section class="parcours-skills" aria-labelledby="parcours-skills-title">
      <h2 id="parcours-skills-title">Profil</h2>
      <div class="parcours-skill-list" data-parcours-skills></div>
    </section>

    <section class="parcours-mobile-flow" data-parcours-mobile data-no-page-wheel aria-label="Parcours mobile">
      <div class="parcours-mobile-frame">
        <section class="parcours-mobile-hero" aria-labelledby="parcours-mobile-title">
          <div class="parcours-mobile-title" aria-hidden="true"></div>
          <img class="parcours-mobile-person" src="/assets/img/marco-parcour.webp" alt="Portrait detoure de Marco avec livres" />

          <div class="parcours-mobile-copy">
            <h1 id="parcours-mobile-title">Mon<br />parcours.</h1>
            <p>De la formation &agrave; l'exp&eacute;rience, un chemin guid&eacute; par la passion et la <b>cr&eacute;ation</b>.</p>
          </div>
        </section>

        <nav class="parcours-mobile-chips" data-parcours-mobile-chips aria-label="Filtres parcours"></nav>

        <section class="parcours-mobile-section parcours-mobile-timeline-section" aria-label="Timeline Parcours">
          <div class="parcours-mobile-timeline" data-parcours-mobile-timeline></div>
        </section>

        <section class="parcours-mobile-section parcours-mobile-experiences" aria-labelledby="parcours-mobile-experiences-title">
          <h2 id="parcours-mobile-experiences-title">Exp&eacute;riences</h2>
          <div class="parcours-mobile-experience-grid" data-parcours-mobile-experiences></div>
        </section>

        <section class="parcours-mobile-section parcours-mobile-profile" aria-labelledby="parcours-mobile-profile-title">
          <h2 id="parcours-mobile-profile-title">Profil</h2>
          <div class="parcours-mobile-skill-list" data-parcours-mobile-skills></div>
        </section>

        <div class="parcours-mobile-player" data-parcours-mobile-player>
          <button class="parcours-mobile-play" type="button" data-parcours-mobile-play aria-label="Lancer la boucle audio">PLAY</button>
          <span class="parcours-mobile-track-index">01</span>
          <strong class="parcours-mobile-track-title">Cinematic Strings</strong>
          <button class="parcours-mobile-music" type="button" data-parcours-mobile-music aria-label="Ouvrir les musiques">Musiques <i aria-hidden="true">&uarr;</i></button>
          <span class="parcours-mobile-bars" aria-hidden="true"></span>
        </div>
      </div>
    </section>
  </section>
</BaseLayout>
