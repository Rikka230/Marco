---
// Home Marco — VALIDEE / intouchable. Portage fidele de index.html.
// Liens en routes propres (Astro file-based) : /music, /projects, /gallery, /contact.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Marco Charlas-Hou - Violoniste Compositeur" page="home" preloadImages={['/assets/img/marco-cover-bg.webp']}>
  <section
    class="page poster-page home"
    data-page="home"
    data-bg="home"
    data-theme="home"
    data-transition-label="MARCO"
  >
    <div class="photo-bg" aria-hidden="true"></div>

    <div class="title-wrap" aria-hidden="true">
      <h1 class="mega first">MARCO</h1>
    </div>

    <h2 class="mega last cover-signature" aria-hidden="true">CHARLAS-HOU</h2>

    <img
      decoding="async"
      class="hero-person"
      src="/assets/img/marco-home.webp"
      alt="Portrait detoure placeholder de Marco avec violon"
    />

    <a class="cover-hit left-a" href="/music">
      <strong>VIOLIN</strong>
      <span>LIVE <i></i> RECORDINGS</span>
    </a>
    <a class="cover-hit left-b" href="/projects">
      <strong>SCORES</strong>
      <span>FILM <i></i> STAGE</span>
    </a>
    <a class="cover-hit right-a" href="/gallery">
      <strong>MODELE</strong>
      <span>PHOTO <i></i> CASTING</span>
    </a>
    <a class="cover-hit right-b" href="/contact">
      <strong>CONTACT</strong>
      <span>BOOKING <i></i> COLLABS</span>
    </a>

    <a class="key-project" href="/projects" aria-label="Voir les scores originaux">
      <span>CINEMATIC STRINGS</span>
      <span>ORIGINAL SCORE</span>
    </a>

    <div class="cover-tagline" aria-hidden="true">
      <span>VIOLINIST COMPOSER</span>
      <span>ACTOR MODEL</span>
    </div>
  </section>
</BaseLayout>
